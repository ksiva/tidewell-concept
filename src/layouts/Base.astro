---
import "@fontsource-variable/bodoni-moda";
import "@fontsource-variable/hanken-grotesk";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title, description = "Small hotels by the Mediterranean, chosen by hand. A concept brand and website.", tone = "light", bare = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Tidewell` : "Tidewell · Small hotels by the Mediterranean"}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f3eee4" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>if(!matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("js-motion");</script>
  </head>
  <body>
    <div class="spec-bar">Concept project<span class="long"> · Tidewell is a fictional brand; hotels, prices and copy are invented. Photos: Unsplash.</span><span class="short"> · fictional brand</span></div>
    {!bare && <Header tone={tone} />}
    <main id="main"><slot /></main>
    <Footer bare={bare} />
    <script>import "../scripts/motion.ts";</script>
  </body>
</html>
<style is:global>
  .spec-bar {
    background: var(--ink); color: var(--limewash); font-size: 12.5px; letter-spacing: .02em;
    text-align: center; padding: 0 var(--gutter); height: 31px; line-height: 31px; white-space: nowrap; overflow: hidden; position: relative; z-index: 60;
  }
  .spec-bar .short { display: none; }
  @media (max-width: 760px) { .spec-bar .long { display: none; } .spec-bar .short { display: inline; } }
</style>
