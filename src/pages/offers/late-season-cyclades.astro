---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { hotels } from "../../data/hotels";
import { photo } from "../../data/photos";
const base = import.meta.env.BASE_URL;
const picks = hotels.filter((h) => h.region === "Cyclades");
const offer = (n: number) => Math.round(n * 3 / 4);
---
<Base title="Late season in the Cyclades" description="Stay four nights, pay for three. Three small Cyclades hotels, 15 September to 25 October." bare>
  <header class="lp-top wrap">
    <a href={base} aria-label="Tidewell home"><Logo /></a>
    <a class="btn" href="#choose" data-magnetic>Choose your hotel</a>
  </header>

  <section class="lp-hero">
    <div class="wrap lp-grid">
      <div class="lp-copy">
        <p class="eyebrow" data-fade data-now>Offer · 15 September to 25 October</p>
        <h1 data-split data-now>The fourth night is <em>on the island.</em></h1>
        <p class="lede" data-fade data-now>Stay four nights at one of three small Cyclades hotels and pay for three. The sea is still warm, the ferries still run, and the villages are yours again.</p>
        <div class="row" data-fade data-now>
          <a class="btn" href="#choose" data-magnetic>See the three hotels <span class="arr">↓</span></a>
          <p class="small">Book by 30 September · free cancellation to 14 days</p>
        </div>
      </div>
      <div class="lp-img frame" data-reveal><Image quality={70} src={photo(26)} alt="White village above the caldera at sunset" widths={[700, 1100, 1500]} sizes="(max-width: 900px) 92vw, 46vw" loading="eager" /></div>
    </div>
  </section>

  <section class="how wrap" aria-label="How the offer works">
    <div><span class="n">4</span><p><strong>nights</strong> minimum stay, arriving any day in the window</p></div>
    <div><span class="n">3</span><p><strong>nights</strong> charged; the cheapest night is free</p></div>
    <div><span class="n">0</span><p><strong>fees</strong> to change dates up to 14 days before</p></div>
  </section>

  <section class="choose wrap" id="choose">
    <h2 data-split>Pick your <em>island</em></h2>
    <div class="offers">
      {picks.map((h) => (
        <article class="o">
          <a href={`${base}hotels/${h.slug}/`} class="frame o-img" data-cursor="View"><div class="zoom"><Image quality={70} src={photo(h.cover)} alt={`${h.name}, ${h.place}`} widths={[500, 800]} sizes="(max-width: 900px) 92vw, 30vw" /></div></a>
          <p class="eyebrow">{h.place}</p>
          <h3>{h.name}</h3>
          <p class="muted">{h.line}</p>
          <p class="o-price"><s>€{h.fromEUR * 4}</s> <strong>€{offer(h.fromEUR * 4)}</strong> <span>for 4 nights, from</span></p>
          <a class="btn" href={`${base}hotels/${h.slug}/#book`}>Book this offer <span class="arr">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="faq wrap">
    <h2>Before you <em>book</em></h2>
    <details><summary>Which dates count?</summary><p>Arrivals from 15 September to 21 October, departing by 25 October.</p></details>
    <details><summary>Can I split the four nights across two hotels?</summary><p>Not with this offer; the free night applies to four nights in one hotel.</p></details>
    <details><summary>Is breakfast included?</summary><p>Yes, at all three hotels, every morning.</p></details>
    <details><summary>How do I get there?</summary><p>All three islands have daily ferries from Piraeus in the offer window. We send ferry times with your confirmation.</p></details>
  </section>

  <section class="final">
    <div class="wrap fin">
      <h2>Late light, warm sea, <em>one night free.</em></h2>
      <a class="btn light" href="#choose" data-magnetic>Choose your hotel <span class="arr">→</span></a>
    </div>
  </section>
</Base>

<style>
  .lp-top { display: flex; justify-content: space-between; align-items: center; height: 84px; }
  .lp-top .btn { padding: 12px 18px; font-size: 14px; }
  .lp-hero { padding: clamp(24px, 4vw, 56px) 0 clamp(64px, 8vw, 110px); }
  .lp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: center; }
  .lp-copy h1 { font-size: clamp(48px, 6.6vw, 104px); margin: 14px 0 24px; } .lp-copy h1 em { font-style: italic; color: var(--terracotta); }
  .lp-copy .lede { margin-bottom: 32px; }
  .row { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .small { font-size: 14px; color: var(--ink-3); margin: 0; }
  .lp-img { aspect-ratio: 4 / 5; }
  .how { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
  .how div { padding: 28px 24px 28px 0; display: flex; gap: 18px; align-items: center; }
  .how div + div { border-left: 1px solid var(--line); padding-left: 24px; }
  .n { font-family: var(--f-display); font-size: 76px; line-height: 1; color: var(--terracotta); }
  .how p { margin: 0; color: var(--ink-2); }
  .choose { padding-top: clamp(72px, 9vw, 130px); } .choose h2 { margin-bottom: 44px; } .choose h2 em { font-style: italic; }
  .offers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .o-img { display: block; aspect-ratio: 4 / 5; margin-bottom: 16px; }
  .o .zoom { position: absolute; inset: 0; transition: transform 1.2s var(--ease); } .o-img:hover .zoom { transform: scale(1.06); }
  .o h3 { margin: 4px 0 6px; } .o .muted { min-height: 3.2em; }
  .o-price { margin: 14px 0 18px; font-size: 15px; } .o-price s { color: var(--ink-3); } .o-price strong { font-family: var(--f-display); font-size: 36px; font-weight: 400; color: var(--terracotta-dk); }
  .o-price span { display: block; color: var(--ink-3); }
  .faq { padding-top: clamp(72px, 9vw, 130px); padding-bottom: clamp(72px, 9vw, 130px); max-width: 920px; }
  .faq h2 { margin-bottom: 28px; } .faq h2 em { font-style: italic; }
  details { border-top: 1px solid var(--line); padding: 18px 0; } details:last-of-type { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; font-weight: 600; font-size: 18px; list-style: none; display: flex; justify-content: space-between; }
  summary::after { content: "+"; font-size: 24px; line-height: 1; transition: transform .4s var(--ease); } details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 10px 0 0; color: var(--ink-2); }
  .final { background: var(--terracotta); color: var(--paper); padding: clamp(64px, 8vw, 110px) 0; }
  .fin { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; } .fin h2 { max-width: 16ch; } .fin h2 em { font-style: italic; }
  .final .btn.light:hover { color: var(--paper); } .final .btn.light::before { background: var(--ink); }
  @media (max-width: 900px) {
    .lp-grid, .offers { grid-template-columns: 1fr; } .how { grid-template-columns: 1fr; }
    .how div + div { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); }
    .lp-img { aspect-ratio: 4 / 3; order: -1; }
  }
</style>
