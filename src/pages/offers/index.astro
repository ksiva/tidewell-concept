---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Offers" description="Current Tidewell offers.">
  <section class="wrap o">
    <p class="eyebrow">Offers</p>
    <h1>One offer, <em>this season.</em></h1>
    <a class="card" href={`${base}offers/late-season-cyclades/`}><span class="t">Late season in the Cyclades</span><span class="muted">Stay four nights, pay for three · 15 September to 25 October</span><span class="btn">See the offer <span class="arr">→</span></span></a>
  </section>
</Base>
<style>
  .o { padding-top: clamp(56px, 8vw, 110px); padding-bottom: clamp(80px, 10vw, 140px); } .o h1 { margin: 12px 0 40px; } .o h1 em { font-style: italic; }
  .card { display: grid; gap: 12px; justify-items: start; text-decoration: none; background: var(--sand); padding: 40px; }
  .t { font-family: var(--f-display); font-size: clamp(30px, 3.4vw, 48px); line-height: 1.05; }
</style>
