---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import HotelCard from "../../components/HotelCard.astro";
import { hotels, type Hotel } from "../../data/hotels";
import { photo, alt } from "../../data/photos";

export function getStaticPaths() {
  return hotels.map((h) => ({ params: { slug: h.slug }, props: { h } }));
}
const { h } = Astro.props as { h: Hotel };
const base = import.meta.env.BASE_URL;
const similar = hotels.filter((x) => x.slug !== h.slug && (x.region === h.region || x.moods.some((m) => h.moods.includes(m)))).slice(0, 3);
const story = (await getCollection("journal")).find((s) => s.data.stay === h.slug);
// "The way in": a scroll film for hotels that have one (footage: Pexels 15437344, Atrani by drone).
const film = h.slug === "casa-ombrella" ? {
  base: `${base}film/atrani`, count: 94,
  beats: [
    { at: [0, 0.3], k: "From Amalfi", t: "Ten minutes on foot along the coast road, SS163." },
    { at: [0.3, 0.66], k: "Under the arches", t: "The road passes over the village. Take the steps down." },
    { at: [0.66, 1.01], k: "Piazza Umberto I", t: "The church above, the beach below. Our door is the yellow one." },
  ],
  stops: [{ at: 0, n: "Amalfi" } as { at: number; n: string; short?: string }, { at: 0.36, n: "Arches" }, { at: 0.66, n: "Piazza" }, { at: 0.98, n: "Casa Ombrella", short: "Our door" }],
} : null;
const roomTypes = [
  { name: "Classic room", note: "Garden or village side, queen bed", price: h.fromEUR },
  { name: "Sea room", note: "Private terrace facing the water", price: Math.round(h.fromEUR * 1.35) },
  { name: "Suite", note: "Two rooms, terrace, bath with a view", price: Math.round(h.fromEUR * 1.9) },
];
---
<Base title={`${h.name}, ${h.place}`} description={h.line}>
  <section class="top wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={`${base}hotels/`}>Hotels</a> / <a href={`${base}hotels/?region=${encodeURIComponent(h.region)}`}>{h.region}</a> / <span>{h.name}</span></nav>
    <div class="title-row">
      <div>
        <p class="eyebrow" data-fade data-now>{h.place}, {h.country} · {h.rooms} rooms</p>
        <h1 data-split data-now>{h.name}</h1>
      </div>
      <p class="lede" data-fade data-now>{h.line}</p>
    </div>
  </section>

  <section class="gallery wrap">
    <div class="g-main frame"><Image quality={70} src={photo(h.gallery[0])} alt={alt[h.gallery[0]] ?? h.name} style={`view-transition-name: hotel-${h.slug}`} widths={[800, 1300, 1800]} sizes="(max-width: 900px) 92vw, 64vw" loading="eager" /></div>
    <div class="g-side">
      {h.gallery.slice(1, 3).map((g) => <div class="frame" data-reveal><Image quality={70} src={photo(g)} alt={alt[g] ?? ""} widths={[500, 800]} sizes="(max-width: 900px) 46vw, 30vw" /></div>)}
    </div>
  </section>

  {film && (
    <section class="wayin" data-film data-base={film.base} data-count={film.count} aria-label="How to get here">
      <div class="wayin__stage">
        <canvas aria-hidden="true"></canvas>
        <div class="wayin__shade"></div>
        <p class="wayin__k eyebrow">The way in · scroll</p>
        <div class="wayin__beats">{film.beats.map((b) => (
          <div class="wayin__beat" data-at={b.at.join(",")}><p class="eyebrow">{b.k}</p><p class="wayin__t">{b.t}</p></div>
        ))}</div>
        <div class="wayin__map">
          <span class="wayin__line"><i></i></span>
          <ol class="wayin__stops">{film.stops.map((s) => <li data-at={s.at} style={`--x:${s.at}`}><span class="l">{s.n}</span>{s.short && <span class="s">{s.short}</span>}</li>)}</ol>
        </div>
      </div>
    </section>
  )}

  <section class="body wrap">
    <div class="copy">
      <h2 class="h2s" data-split>Why we <em>chose it</em></h2>
      <ol class="why">{h.why.map((w) => <li data-fade>{w}</li>)}</ol>

      <h2 class="h2s" data-split>Rooms</h2>
      <ul class="rooms">
        {roomTypes.map((r) => (
          <li data-fade><div><h3>{r.name}</h3><p class="muted">{r.note}</p></div><p class="rp">from <strong>€{r.price}</strong></p><a class="btn ghost" href="#book" data-room={r.name}>Select</a></li>
        ))}
      </ul>

      <div class="strip">
        {h.gallery.slice(3, 5).map((g) => <div class="frame" data-reveal><Image quality={70} src={photo(g)} alt={alt[g] ?? ""} widths={[600, 900]} sizes="(max-width: 900px) 46vw, 30vw" /></div>)}
      </div>

      <h2 class="h2s" data-split>Good to know</h2>
      <ul class="facts">{h.facts.map((f) => <li>{f}</li>)}</ul>

      {story && (
        <a class="read" href={`${base}journal/${story.id}/`} data-cursor="Read">
          <div class="frame"><Image quality={70} src={photo(story.data.cover)} alt="" widths={[500]} sizes="220px" /></div>
          <div><p class="eyebrow">From the journal</p><h3>{story.data.title}</h3><p class="muted">{story.data.dek}</p></div>
        </a>
      )}
    </div>

    <aside class="book" id="book" aria-label="Check availability">
      <div class="book-in">
        <p class="bp">From <strong>€{h.fromEUR}</strong> <span>a night, breakfast included</span></p>
        <form class="stay" data-open={h.facts.find((f) => /^Open /.test(f)) ?? ""} data-hotel={h.name}>
          <label><span>Arrive</span><input type="date" name="arrive" required /></label>
          <label><span>Nights</span><select name="nights"><option>2</option><option selected>3</option><option>4</option><option>5</option><option>7</option></select></label>
          <label class="full"><span>Room</span><select name="room">{roomTypes.map((r) => <option value={r.price}>{r.name} · from €{r.price}</option>)}</select></label>
          <label class="full"><span>Guests</span><select name="guests"><option value="1">1 adult</option><option value="2" selected>2 adults</option><option value="3">2 adults, 1 child</option></select></label>
          <div class="sum full" aria-live="polite">
            <p class="sum__when" data-when>Pick a date to see your stay.</p>
            <p class="sum__row"><span data-line>3 nights × €{h.fromEUR}</span><strong data-total>€{h.fromEUR * 3}</strong></p>
            <p class="sum__warn" data-warn hidden></p>
          </div>
          <button class="btn" type="submit" data-magnetic>Request these dates <span class="arr">→</span></button>
        </form>
        <div class="done" hidden tabindex="-1">
          <p class="eyebrow">Request sent · <span data-ref></span></p>
          <h3 data-done-t></h3>
          <p class="muted" data-done-s></p>
          <p class="note">Concept site: no booking is made, and nothing was sent.</p>
          <button class="btn ghost" type="button" data-again>Change dates</button>
        </div>
        <ul class="reassure"><li>{h.facts[1]}</li><li>Best rate when you book with us</li><li>Reply from a real person within a day</li></ul>
      </div>
    </aside>
  </section>

  <section class="similar wrap">
    <h2 data-split>You may also <em>like</em></h2>
    <div class="g3">{similar.map((s) => <HotelCard hotel={s} />)}</div>
  </section>

  <div class="mbar"><p>From <strong>€{h.fromEUR}</strong> / night</p><a class="btn" href="#book">Check availability</a></div>
</Base>

<script>
  import "../../scripts/film.ts";
  // The booking card works out the stay: dates, nights × room rate, a season check, then a confirmation state.
  {
    const form = document.querySelector<HTMLFormElement>("form.stay");
    if (form) {
      const done = document.querySelector<HTMLElement>(".done")!;
      const $ = <T extends Element>(s: string) => form.querySelector<T>(s)!;
      const arrive = $<HTMLInputElement>("[name=arrive]"), nights = $<HTMLSelectElement>("[name=nights]"), room = $<HTMLSelectElement>("[name=room]"), guests = $<HTMLSelectElement>("[name=guests]");
      const today = new Date(); today.setHours(0, 0, 0, 0);
      arrive.min = today.toISOString().slice(0, 10);
      const fmt = (d: Date) => d.toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short" });
      const open = (form.dataset.open || "").match(/Open (\w+) to (\w+)/);
      const months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
      const season = open ? [months.indexOf(open[1]), months.indexOf(open[2])] : null;
      const total = { v: 0 };
      const calc = () => {
        const n = +nights.value, rate = +room.value, roomName = room.selectedOptions[0].text.split(" · ")[0];
        const t = n * rate;
        $<HTMLElement>("[data-line]").textContent = `${n} nights × €${rate} · ${roomName}`;
        const el = $<HTMLElement>("[data-total]");
        const from = total.v; total.v = t;
        const k0 = performance.now();
        const step = (k: number) => { const q = Math.min(1, (k - k0) / 450); el.textContent = `€${Math.round(from + (t - from) * (1 - (1 - q) ** 3))}`; if (q < 1) requestAnimationFrame(step); };
        requestAnimationFrame(step);
        const warn = $<HTMLElement>("[data-warn]"); warn.hidden = true;
        if (arrive.value) {
          const a = new Date(arrive.value + "T12:00:00"), out = new Date(a); out.setDate(a.getDate() + n);
          $<HTMLElement>("[data-when]").textContent = `In ${fmt(a)} · out ${fmt(out)}`;
          if (a < today) { warn.textContent = "That date has passed."; warn.hidden = false; }
          else if (season && (a.getMonth() < season[0] || out.getMonth() > season[1] || a.getFullYear() !== out.getFullYear())) { warn.textContent = `${form.dataset.hotel} is open ${open![1]} to ${open![2]}. Try a date in season.`; warn.hidden = false; }
          if (+guests.value > 2 && room.selectedIndex === 0) { warn.textContent = "A child's bed fits the Sea room or the Suite."; warn.hidden = false; }
        } else $<HTMLElement>("[data-when]").textContent = "Pick a date to see your stay.";
      };
      [arrive, nights, room, guests].forEach((x) => { x.addEventListener("input", calc); x.addEventListener("change", calc); });
      calc();
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        calc();
        if (!$<HTMLElement>("[data-warn]").hidden) { $<HTMLElement>("[data-warn]").animate([{ transform: "translateX(-4px)" }, { transform: "translateX(4px)" }, { transform: "none" }], { duration: 240 }); return; }
        const n = +nights.value, a = new Date(arrive.value + "T12:00:00"), out = new Date(a); out.setDate(a.getDate() + n);
        done.querySelector("[data-ref]")!.textContent = "TW-" + Math.random().toString(36).slice(2, 7).toUpperCase();
        done.querySelector("[data-done-t]")!.textContent = `${room.selectedOptions[0].text.split(" · ")[0]}, ${n} nights`;
        done.querySelector("[data-done-s]")!.textContent = `${fmt(a)} to ${fmt(out)} · ${guests.selectedOptions[0].text} · €${n * +room.value} in total. A real person replies within a day.`;
        form.hidden = true; done.hidden = false; done.focus();
      });
      done.querySelector("[data-again]")!.addEventListener("click", () => { done.hidden = true; form.hidden = false; arrive.focus(); });
      // "Select" on a room row picks that room here and recalculates
      document.querySelectorAll<HTMLAnchorElement>("[data-room]").forEach((a) => a.addEventListener("click", () => {
        room.selectedIndex = [...room.options].findIndex((o) => o.text.startsWith(a.dataset.room!));
        calc();
      }));
    }
  }
</script>

<style>
  .top { padding-top: 28px; }
  .crumbs { font-size: 14px; color: var(--ink-3); margin-bottom: clamp(32px, 5vw, 64px); }
  .crumbs a { text-decoration: none; } .crumbs a:hover { text-decoration: underline; }
  .title-row { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: end; padding-bottom: 40px; }
  .title-row h1 { font-size: clamp(52px, 8vw, 128px); margin-top: 10px; }
  .gallery { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; }
  .g-main { aspect-ratio: 4 / 3; }
  .g-side { display: grid; gap: 16px; } .g-side .frame { height: 100%; min-height: 0; }
  .body { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: clamp(40px, 6vw, 96px); padding-top: clamp(64px, 8vw, 112px); align-items: start; }
  .h2s { font-size: clamp(34px, 3.6vw, 52px); margin: 0 0 28px; } .h2s em { font-style: italic; }
  .why { list-style: none; counter-reset: w; padding: 0; margin: 0 0 72px; display: grid; gap: 22px; }
  .why li { counter-increment: w; display: grid; grid-template-columns: 52px 1fr; font-size: 19px; line-height: 1.5; border-top: 1px solid var(--line); padding-top: 18px; }
  .why li::before { content: counter(w); font-family: var(--f-display); font-style: italic; font-size: 32px; color: var(--terracotta); line-height: 1; }
  .rooms { list-style: none; padding: 0; margin: 0 0 56px; border-top: 1px solid var(--ink); }
  .rooms li { display: grid; grid-template-columns: 1fr auto auto; gap: 24px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .rooms h3 { font-size: 26px; } .rooms p { margin: 4px 0 0; } .rp { font-size: 15px; white-space: nowrap; }
  .rooms .btn { padding: 11px 18px; }
  .strip { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 72px; } .strip .frame { aspect-ratio: 4 / 5; }
  .facts { list-style: none; padding: 0; margin: 0 0 56px; display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
  .facts li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .read { display: grid; grid-template-columns: 220px 1fr; gap: 24px; align-items: center; text-decoration: none; background: var(--sand); padding: 16px; }
  .read .frame { aspect-ratio: 4 / 3; } .read h3 { margin: 6px 0; }
  .book { position: sticky; top: 100px; }
  .book-in { background: var(--paper); padding: 28px; box-shadow: 0 40px 80px -40px rgba(20,32,51,.35); border-top: 3px solid var(--terracotta); }
  .bp { font-size: 15px; margin: 0 0 20px; } .bp strong { font-family: var(--f-display); font-size: 44px; font-weight: 400; } .bp span { display: block; color: var(--ink-3); }
  form { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  label { display: flex; flex-direction: column; border: 1px solid var(--line); padding: 8px 12px; } label.full { grid-column: 1 / -1; }
  label span { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--terracotta-dk); }
  label input, label select { border: 0; background: transparent; padding: 2px 0; font-size: 15px; min-width: 0; }
  form .btn { grid-column: 1 / -1; justify-content: center; margin-top: 6px; }
  .note { grid-column: 1 / -1; margin: 0; font-size: 14px; color: var(--terracotta-dk); }
  form[hidden], .done[hidden] { display: none; }
  .sum { grid-column: 1 / -1; border-top: 1px solid var(--line); padding-top: 12px; margin-top: 2px; }
  .sum p { margin: 0; }
  .sum__when { font-size: 14px; color: var(--ink-2); min-height: 1.4em; }
  .sum__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 12px; margin-top: 6px !important; font-size: 14px; color: var(--ink-2); }
  .sum__row [data-line] { flex: 1 1 160px; }
  .sum__row strong { font-family: var(--f-display); font-size: 30px; font-weight: 400; font-variant-numeric: tabular-nums; }
  .sum__warn { margin-top: 8px !important; font-size: 13.5px; color: var(--terracotta-dk); }
  .done { display: grid; gap: 10px; animation: doneIn .6s cubic-bezier(.23,1,.32,1); }
  .done h3 { font-size: 28px; margin: 0; }
  .done .btn { justify-self: start; }
  @keyframes doneIn { from { opacity: 0; transform: translateY(8px); } }
  .reassure { list-style: none; padding: 0; margin: 20px 0 0; font-size: 14px; display: grid; gap: 6px; color: var(--ink-2); }
  .reassure li::before { content: "✓"; color: var(--olive); margin-right: 8px; font-weight: 700; }
  .similar { padding: clamp(80px, 10vw, 140px) var(--gutter); } .similar h2 { margin-bottom: 44px; } .similar h2 em { font-style: italic; }
  .g3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .mbar { display: none; }
  /* The way in: tall section, sticky stage, the film played by scroll */
  .wayin { position: relative; height: 340svh; margin-top: clamp(64px, 8vw, 112px); }
  .wayin__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; background: var(--ink); color: var(--paper); }
  .wayin canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .wayin__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,32,51,.45), transparent 30%, transparent 55%, rgba(20,32,51,.7)); pointer-events: none; }
  .wayin__k { position: absolute; left: var(--gutter); top: 84px; margin: 0; color: var(--limewash); }
  .wayin__beat { position: absolute; left: var(--gutter); bottom: 140px; max-width: 560px; opacity: 0; transform: translateY(18px); transition: opacity .7s var(--ease), transform .9s var(--ease); }
  .wayin__beat.is-on { opacity: 1; transform: none; }
  .wayin__beat .eyebrow { color: var(--limewash); margin: 0 0 10px; }
  .wayin__t { font-family: var(--f-display); font-size: clamp(30px, 3.8vw, 58px); line-height: 1.04; margin: 0; text-wrap: balance; }
  .wayin__map { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 48px; }
  .wayin__line { display: block; height: 1px; background: rgba(243,238,228,.3); }
  .wayin__line i { display: block; height: 100%; background: var(--paper); transform-origin: left; transform: scaleX(0); }
  .wayin__stops { list-style: none; margin: 0; padding: 0; position: relative; height: 34px; }
  .wayin__stops li { position: absolute; top: -4px; left: calc(var(--x) * 100%); }
  .wayin__stops li::before { content: ""; display: block; width: 9px; height: 9px; border-radius: 50%; background: var(--ink); border: 1.5px solid var(--paper); margin-left: -4.5px; transition: background .4s; }
  .wayin__stops li.is-on::before { background: var(--paper); }
  .wayin__stops span { position: absolute; top: 16px; transform: translateX(-50%); white-space: nowrap; font-size: 12.5px; letter-spacing: .1em; text-transform: uppercase; opacity: .55; transition: opacity .4s; }
  .wayin__stops li.is-on span { opacity: 1; }
  .wayin__stops li:last-child span { transform: translateX(-100%); }
  .wayin__stops li:first-child span { transform: none; }
  .wayin__stops .s { display: none; }
  @media (max-width: 900px) { .wayin__stops .s { display: inline; } }
  /* Without JavaScript: one screen, the arrival frame, all captions */
  :global(html:not(.js-on)) .wayin { height: 100svh; }
  :global(html:not(.js-on)) .wayin__beat { opacity: 1; transform: none; position: static; max-width: none; }
  :global(html:not(.js-on)) .wayin__beat .wayin__t { font-size: clamp(20px, 1.8vw, 28px); }
  :global(html:not(.js-on)) .wayin__stage { display: grid; align-content: end; }
  :global(html:not(.js-on)) .wayin__beats { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 110px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  :global(html:not(.js-on)) .wayin__line i { transform: scaleX(1); }
  :global(html:not(.js-on)) .wayin__stops span { opacity: 1; }
  :global(html:not(.js-on)) .wayin__stops li::before { background: var(--paper); }
  @media (max-width: 900px) { :global(html:not(.js-on)) .wayin__beats { grid-template-columns: 1fr; gap: 12px; bottom: 150px; } }
  @media (max-width: 900px) {
    .title-row, .body { grid-template-columns: 1fr; }
    .gallery { grid-template-columns: 1fr; } .g-side { grid-template-columns: 1fr 1fr; } .g-side .frame { aspect-ratio: 1; }
    .book { position: static; }
    .g3 { grid-template-columns: 1fr; gap: 48px; }
    .facts { grid-template-columns: 1fr; }
    .read { grid-template-columns: 1fr; }
    .rooms li { grid-template-columns: 1fr auto; } .rooms .rp { grid-column: 1; } .rooms .btn { grid-column: 2; grid-row: 1 / span 2; min-height: 44px; }
    .wayin__beat { bottom: 168px; right: var(--gutter); }
    .wayin__map { bottom: 96px; }
    .wayin__shade { background: linear-gradient(180deg, rgba(20,32,51,.45), transparent 30%, transparent 45%, rgba(20,32,51,.85)); }
    .wayin__stops span { font-size: 10.5px; }
    .wayin__stops li:has(.s) .l { display: none; }
    .mbar { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: var(--paper); box-shadow: 0 -1px 0 var(--line); padding: 10px var(--gutter); align-items: center; justify-content: space-between; gap: 12px; }
    .mbar p { margin: 0; font-size: 15px; } .mbar .btn { padding: 12px 18px; }
    :global(body) { padding-bottom: 68px; }
  }
</style>
