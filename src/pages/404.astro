---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Not found">
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>This page has gone quiet.</h1>
    <p class="lede">The address may have changed. Try the collection instead.</p>
    <a class="btn" href={`${base}hotels/`}>See the collection <span class="arr">→</span></a>
  </section>
</Base>
<style>.nf { padding-top: clamp(64px, 10vw, 140px); padding-bottom: clamp(80px, 12vw, 160px); } .nf h1 { margin: 12px 0 20px; } .nf .lede { margin-bottom: 28px; }</style>
