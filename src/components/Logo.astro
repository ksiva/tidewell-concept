---
// Tidewell mark: a sun meeting the horizon, two lines of tide below.
const { size = 34, withWord = true, class: cls = "" } = Astro.props;
---
<span class={`logo ${cls}`}>
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
    <circle cx="20" cy="20" r="18.5" />
    <path d="M9.5 21h21" />
    <path d="M13 21a7 7 0 0 1 14 0" fill="currentColor" stroke="none" />
    <path d="M12 25.5c2.7-1.6 5.3-1.6 8 0s5.3 1.6 8 0" />
    <path d="M14.5 29.5c1.8-1 3.7-1 5.5 0s3.7 1 5.5 0" />
  </svg>
  {withWord && <span class="word">Tidewell</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: inherit; }
  .word { font-family: var(--f-display); font-style: italic; font-size: 27px; letter-spacing: -0.01em; line-height: 1; }
</style>
